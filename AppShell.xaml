<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DogMeetGo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DogMeetGo.Pages"
    Shell.NavBarIsVisible="False"
    Title="DogMeetGo">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:HomePage}" Route="home"/>
        </Tab>
        <Tab Title="Discover" Icon="compass.png">
            <ShellContent ContentTemplate="{DataTemplate local:DiscoverPage}" Route="discover"/>
        </Tab>
        <Tab Title="My Dogs" Icon="paw.png">
            <ShellContent ContentTemplate="{DataTemplate local:DogsPage}" Route="dogs"/>
        </Tab>
        <Tab Title="Me" Icon="user.png">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="profile"/>
        </Tab>
    </TabBar>

</Shell>
