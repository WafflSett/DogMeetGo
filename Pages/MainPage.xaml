<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:DogMeetGo.Views"
             BackgroundColor="Beige"
             Shell.TabBarIsVisible="False"
             x:Class="DogMeetGo.Pages.MainPage">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="Black" StatusBarStyle="LightContent"/>
    </ContentPage.Behaviors>
    <Grid RowDefinitions="*,5*">
        <views:HeaderView Title="Welcome"/>
        <Grid RowDefinitions=".7*,2.5*,*,2*" Grid.Row="1" Margin="30,10">
            <Label Text="Meet local dog owners and join walks!" HorizontalOptions="Center" FontAttributes="Bold"/>
            <VerticalStackLayout Grid.Row="1" Spacing="15" VerticalOptions="Start">
                <Border  Background="White" StrokeShape="RoundRectangle 30" Padding="10, 5" VerticalOptions="Center">
                    <Entry Text="{Binding Email}" Placeholder="Email" VerticalOptions="Center"/>
                </Border>
                <Border Background="White" StrokeShape="RoundRectangle 30" Padding="10, 5" VerticalOptions="Center">
                    <Entry Text="{Binding Password}" Placeholder="Password" VerticalOptions="Center"/>
                </Border>
                <Button Text="Sign Up" Command="{Binding SignUpCommand}" VerticalOptions="Center" HorizontalOptions="Center" Padding="70, 15" Background="Gold" TextColor="Black"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="2" VerticalOptions="Start" Spacing="5">
                <Label Text="Already have an account?" HorizontalOptions="Center" VerticalOptions="End"/>
                <Button Text="Log In" Command="{Binding LogInCommand}" VerticalOptions="Center" HorizontalOptions="Center" Padding="70, 15" Background="DarkSlateGrey"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="3">
                <Label Text="or" HorizontalOptions="Center" FontAttributes="Italic"/>
                <Label Text="Continue as Guest" HorizontalOptions="Center" FontAttributes="Bold" TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GuestCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
