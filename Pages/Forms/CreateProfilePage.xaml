<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DogMeetGo.Pages.CreateProfilePage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:DogMeetGo.Views"
             BackgroundColor="Beige"
             Title="CreateProfilePage">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="Black" StatusBarStyle="LightContent"/>
    </ContentPage.Behaviors>
    <Grid RowDefinitions="*,5*">
        <views:HeaderView Title="Create Your Profile"/>
        <Grid Grid.Row="1" RowDefinitions="2*,*,*,*,*,*,2*" Margin="10">
            <Border Background="White" StrokeShape="RoundRectangle 100" Padding="10,5" VerticalOptions="Center" HeightRequest="100" WidthRequest="100">
                <ImageButton Source="{Binding ImgPath}" Command="{Binding AddImageCommand}"/>
            </Border>
            <!--<Border Background="White" StrokeShape="RoundRectangle 100" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center">
                
            </Border>-->
            <Border Grid.Row="1" Background="White" StrokeShape="RoundRectangle 30" Padding="10, 5" VerticalOptions="Center">
                <Entry Placeholder="Enter your name" VerticalOptions="Center" Text="{Binding Name}"/>
            </Border>
            <Border Grid.Row="2" Background="White" StrokeShape="RoundRectangle 30" Padding="10, 5" VerticalOptions="Center">
                <Entry Placeholder="City, Neighbourhood" VerticalOptions="Center" Text="{Binding City}"/>
            </Border>
            <Border Grid.Row="3" Background="White" StrokeShape="RoundRectangle 30" Padding="10, 5" VerticalOptions="Center">
                <Entry Placeholder="Tell other dog owners a little bit about yourself" VerticalOptions="Center" Text="{Binding About}"/>
            </Border>

            <Button Grid.Row="4" Text="Create Profile" Padding="50, 10" VerticalOptions="Center" Command="{Binding ContinueCommand}"/>
        </Grid>
    </Grid>
</ContentPage>